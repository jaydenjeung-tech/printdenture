# Copy to .env.local for local dev, or run: vercel env pull .env.local --environment=development

# Supabase (shared with PrintCrown if same project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PrintDenture storefront
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_SITE=printdenture

# Stripe (PrintCrown account — add a separate webhook for PrintDenture URL)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=
ADMIN_EMAIL=

# Optional: AI crown design (order flow)
# DENTBIRD_API_KEY=
