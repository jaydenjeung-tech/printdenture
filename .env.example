# Copy to .env.local for local dev, or run: vercel env pull .env.local --environment=development

# Supabase (shared with PrintCrown if same project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PrintDenture storefront (production: https://printdenture.com — NOT printcrown.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_SITE=printdenture

# Stripe (PrintCrown account — add a separate webhook for PrintDenture URL)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=
ADMIN_EMAIL=
# Provider demo & program applications (comma-separated; defaults to iDoc lab addresses)
# PROVIDER_INQUIRY_EMAILS=haesung@idocdentallab.com,dj@idocdentallab.com

# Design outsource partner (Korea — JD)
DESIGN_PARTNER_NAME=JD
DESIGN_PARTNER_EMAIL=
# Partner portal: create auth user + set profiles.role = design_partner

# Optional: AI crown design (order flow)
# DENTBIRD_API_KEY=
